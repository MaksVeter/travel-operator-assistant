# Deployed API Gateway base URL (include stage path, no trailing slash), e.g. https://abc123.execute-api.eu-north-1.amazonaws.com/dev
ASSISTANT_API_URL=https://xxxxxxxx.execute-api.eu-north-1.amazonaws.com/dev

AWS_REGION=eu-north-1
OPENSEARCH_ENDPOINT=https://<collection-id>.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX=dsl-commands
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# Use an inference profile ID in regions where direct foundation-model ID fails (e.g. Claude Haiku 4.5).
# EU (eu-north-1, etc.): eu.anthropic.claude-haiku-4-5-20251001-v1:0
# US: us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_REGION=eu-north-1
RETRIEVAL_TOP_K=3
MAX_QUERY_TOKENS=600
FORCE_RECREATE_INDEX=false
LOG_LEVEL=info
# Optional: ASSISTANT_DEBUG=1 on Lambda includes "debug" array in responses (omit in production). CLI: --debug, -d, or CLI_DEBUG=1.
# ASSISTANT_DEBUG=0
OPENSEARCH_EXTRA_PRINCIPAL_ARNS=arn:aws:iam::<account-id>:user/cliuser,arn:aws:iam::<account-id>:root

# --- Sabre SOAP (SabreCommandLLSRQ) — used by TravelAssistantSabreCommand stack at cdk deploy ---
# CERT SOAP endpoint (Postman / Sabre Dev Studio). Production: https://webservices.platform.sabre.com/websvc
SABRE_SOAP_URL=https://webservices.cert.platform.sabre.com/websvc
# EPR username (SOAP UI: wsse:Username) and Sabre-provisioned password
SABRE_USERNAME=
SABRE_PASSWORD=
# PCC / office (SOAP UI: Organization, CPAId; often same as PseudoCityCode)
SABRE_ORGANIZATION=
# Optional if different from SABRE_ORGANIZATION
SABRE_PSEUDO_CITY_CODE=
SABRE_DOMAIN=DEFAULT
# eb:MessageHeader PartyId placeholders from your SOAP UI project (From / To)
SABRE_PARTY_FROM=99999
SABRE_PARTY_TO=123123
SABRE_COMMAND_VERSION=2.0.0
# Deployed Sabre API (optional): POST {base}/command  body {"command":"..."} — optional "dryRun": true runs IgnoreTransactionLLSRQ after (discard edits).
# POST {base}/validate  body {"command":"..."} — validation only (always dry-run); response {"valid":true} or {"valid":false,"error":"..."}.

# After deploy: https://....amazonaws.com/{stage}/ — same pattern as ASSISTANT_API_URL
# SABRE_COMMAND_API_URL=
