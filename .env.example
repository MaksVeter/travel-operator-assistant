# Deployed API Gateway base URL (include stage path, no trailing slash), e.g. https://abc123.execute-api.eu-north-1.amazonaws.com/dev
ASSISTANT_API_URL=https://xxxxxxxx.execute-api.eu-north-1.amazonaws.com/dev

AWS_REGION=eu-north-1
OPENSEARCH_ENDPOINT=https://<collection-id>.us-east-1.aoss.amazonaws.com
OPENSEARCH_INDEX=dsl-commands
EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# Use an inference profile ID in regions where direct foundation-model ID fails (e.g. Claude Haiku 4.5).
# EU (eu-north-1, etc.): eu.anthropic.claude-haiku-4-5-20251001-v1:0
# US: us.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_REGION=eu-north-1
RETRIEVAL_TOP_K=3
MAX_QUERY_TOKENS=600
FORCE_RECREATE_INDEX=false
LOG_LEVEL=info
OPENSEARCH_EXTRA_PRINCIPAL_ARNS=arn:aws:iam::<account-id>:user/cliuser,arn:aws:iam::<account-id>:root
