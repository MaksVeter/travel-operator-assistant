{
  "name": "travel-operator-assistant",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "lint": "bunx @biomejs/biome lint --write .",
    "lint:check": "bunx @biomejs/biome lint .",
    "check": "bunx @biomejs/biome check .",
    "check:fix": "bunx @biomejs/biome check --write .",
    "cdk": "cd packages/infra && bunx cdk",
    "cdk:ls": "cd packages/infra && bunx cdk ls",
    "cdk:bootstrap": "cd packages/infra && bunx cdk bootstrap",
    "cdk:deploy": "cd packages/infra && bunx cdk deploy --all",
    "cdk:deploy:opensearch": "cd packages/infra && bunx cdk deploy TravelAssistantOpenSearch",
    "cdk:deploy:indexer": "cd packages/infra && bunx cdk deploy TravelAssistantIndexer",
    "cdk:deploy:api": "cd packages/infra && bunx cdk deploy TravelAssistantApi",
    "cdk:deploy:sabre": "cd packages/infra && bunx cdk deploy TravelAssistantSabreCommand",
    "cdk:destroy": "cd packages/infra && bunx cdk destroy --all",
    "env:sync": "bash scripts/sync-env-to-packages.sh",
    "opensearch:check-index": "bun run packages/indexer/src/check-opensearch-index.ts",
    "indexer:local": "bun run packages/indexer/src/local.ts",
    "assistant:local": "bun run packages/assistant/src/local.ts",
    "sabre-command:local": "bun run packages/sabre-command/src/local.ts",
    "cli": "bun run packages/cli/src/main.ts",
    "cli:v2": "bun run packages/cli/src/main.ts --v2",
    "cli:debug-smoke": "bash scripts/cli-debug-smoke.sh",
    "generate:validation-dataset": "bun run scripts/generate-validation-dataset.ts",
    "validate:dataset-sabre": "bun run scripts/validate-dataset-sabre.ts",
    "evaluate:assistant": "bun run scripts/evaluate-assistant-dataset.ts",
    "precompute:intent-centroids": "bun run scripts/precompute-intent-centroids.ts",
    "evaluate:v2": "bun run scripts/evaluate-assistant-dataset.ts --endpoint /v2/translate",
    "compare:v1-v2": "bun run scripts/compare-v1-v2.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
